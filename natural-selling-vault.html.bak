<!DOCTYPE html>
<html lang="en">
<head>
<link rel="icon" type="image/x-icon" href="favicon.ico">
<link rel="apple-touch-icon" href="apple-touch-icon.png">

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>GRWTH Coach — The Natural Selling Vault</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&family=Geist+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --teal-700: #0B7A70; --teal-600: #0D9488; --teal-500: #14B8A6; --teal-400: #2DD4BF; --teal-100: #E3F5F2;
    --slate-950: #0E1018; --slate-900: #1A1A2E;
    --bg: #F4F6F8; --white: #FFFFFF;
    --ink-900: #12141F; --ink-700: #2E3244; --ink-500: #6B7280; --ink-400: #9098A8; --ink-300: #D1D5DB;
    --line: #E4E7EC;
    --amber-600: #C08A2E; --amber-100: #FBF1DD;
    --rose-600: #D5493A; --rose-100: #FBE6E3;
    --font-display: 'Geist', -apple-system, sans-serif;
    --font-body: 'Geist', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-mono: 'Geist Mono', monospace;
    --radius: 16px; --radius-sm: 10px;
    --shadow-card: 0 1px 2px rgba(14,16,24,0.04), 0 12px 28px -14px rgba(14,16,24,0.14);  }

  html[data-theme="dark"] {
    --bg: #0B0E17;
    --white: #121A29;
    --ink-900: #FFFFFF;
    --ink-700: #E4E7EC;
    --ink-500: #9098A8;
    --ink-400: #6B7280;
    --ink-300: #363C54;
    --line: #1D2C42;
    --amber-100: #2E230F;
    --rose-100: #2E1512;
    --teal-100: #0E262A;
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); font-family: var(--font-body); color: var(--ink-900); -webkit-font-smoothing: antialiased; }
  a { text-decoration: none; color: inherit; }
  button { font-family: inherit; cursor: pointer; }

  .app { display: grid; grid-template-columns: 240px 1fr; min-height: 100vh; }
  .sidebar { background: var(--white); color: var(--ink-700); padding: 22px 14px; display: flex; flex-direction: column; position: sticky; top: 0; height: 100vh; border-right: 1px solid var(--line); }
  .brand { display: flex; align-items: center; gap: 11px; padding: 0 8px 20px 8px; margin-bottom: 16px; }
  .brand-mark { width: 34px; height: 34px; border-radius: 9px; background: linear-gradient(155deg, var(--teal-400), var(--teal-600)); box-shadow: 0 4px 12px -4px rgba(13,148,136,0.5); display: flex; align-items: center; justify-content: center; font-family: var(--font-display); font-weight: 700; font-size: 14px; color: #fff; flex-shrink: 0; }
  .brand-name { font-family: var(--font-display); font-weight: 700; font-size: 16px; color: var(--ink-900); }
  .brand-sub { font-size: 9.5px; color: var(--teal-600); text-transform: uppercase; letter-spacing: 1.3px; font-weight: 700; }
  .org-card { background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; margin-bottom: 18px; }
  .org-card-label { font-size: 9.5px; text-transform: uppercase; letter-spacing: 0.8px; font-weight: 700; color: var(--ink-400); margin-bottom: 3px; }
  .org-card-name { font-size: 13px; font-weight: 700; color: var(--ink-900); margin-bottom: 6px; }
  .org-badge { display: inline-block; font-size: 10px; font-weight: 700; color: var(--teal-700); background: var(--teal-100); padding: 2px 8px; border-radius: 999px; }
  .nav-group-label { font-size: 10px; text-transform: uppercase; letter-spacing: 1.1px; font-weight: 700; color: var(--ink-400); padding: 0 12px; margin: 16px 0 7px; }
  .nav-group-label:first-of-type { margin-top: 0; }
  .nav-item { display: flex; align-items: center; gap: 11px; padding: 9px 12px; border-radius: 9px; font-size: 13.5px; font-weight: 500; color: var(--ink-500); background: transparent; border: none; width: 100%; text-align: left; transition: background 0.15s ease, color 0.15s ease; }
  .nav-item:hover { background: var(--bg); color: var(--ink-900); }
  .nav-item.active { background: var(--teal-100); color: var(--teal-700); font-weight: 700; }
  .nav-icon { width: 17px; height: 17px; flex-shrink: 0; opacity: 0.85; }
  .sidebar-footer { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line); display: flex; align-items: center; gap: 10px; }
  .avatar-sm { width: 32px; height: 32px; border-radius: 50%; background: linear-gradient(155deg, var(--teal-500), var(--teal-700)); display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #06110F; flex-shrink: 0; }
  .footer-name { font-size: 12.5px; font-weight: 600; color: var(--ink-900); line-height: 1.3; }
  .footer-role { font-size: 10.5px; color: var(--ink-400); }

  .main { padding: 36px 44px 70px; max-width: 1180px; margin: 0 auto; }
  .topbar-eyebrow { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.4px; color: var(--teal-600); margin-bottom: 6px; }
  .topbar h1 { font-family: var(--font-display); font-weight: 700; font-size: 30px; letter-spacing: -0.6px; margin: 0 0 4px; color: var(--ink-900); }
  .topbar h1 em { font-style: italic; color: var(--teal-600); font-weight: 800; }
  .topbar-sub { font-size: 13.5px; color: var(--ink-500); margin-bottom: 26px; }

  .method-card { background: radial-gradient(circle at 85% -10%, rgba(45,212,191,0.3), transparent 55%), linear-gradient(150deg, var(--slate-900), var(--slate-950)); border-radius: var(--radius); padding: 28px 30px; margin-bottom: 30px; color: #fff; }
  .method-lead { font-family: var(--font-display); font-style: italic; font-size: 17px; line-height: 1.5; margin-bottom: 14px; color: #fff; }
  .method-para { font-size: 13px; line-height: 1.65; color: #C7D0D3; margin-bottom: 10px; }
  .method-stages { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 18px; }
  .method-stage { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 10px; padding: 12px 14px; }
  .method-stage-title { font-family: var(--font-display); font-weight: 700; font-size: 12.5px; color: var(--teal-400); margin-bottom: 4px; }
  .method-stage-desc { font-size: 11px; color: #9DB0B4; line-height: 1.4; }
  @media (max-width: 900px) { .method-stages { grid-template-columns: 1fr 1fr; } }

  .section-label { font-family: var(--font-display); font-weight: 700; font-size: 13px; margin: 30px 0 14px; color: var(--ink-700); text-transform: uppercase; letter-spacing: 0.6px; }

  .module-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  @media (max-width: 800px) { .module-grid { grid-template-columns: 1fr; } }
  .module-card { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-card); padding: 20px 22px; cursor: pointer; transition: transform 0.12s ease, box-shadow 0.12s ease; }
  .module-card:hover { transform: translateY(-2px); box-shadow: 0 20px 40px -18px rgba(14,16,24,0.2); }
  .module-card-top { display: flex; align-items: center; gap: 10px; margin-bottom: 8px; }
  .module-ix { font-family: var(--font-mono); font-weight: 700; font-size: 11px; color: var(--ink-400); }
  .module-tag { font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; padding: 3px 9px; border-radius: 999px; background: var(--teal-100); color: var(--teal-700); }
  .module-title { font-family: var(--font-display); font-weight: 700; font-size: 16px; margin-bottom: 6px; }
  .module-desc { font-size: 12.5px; color: var(--ink-500); line-height: 1.5; }
  .module-lesson-count { font-size: 11px; color: var(--ink-400); margin-top: 10px; font-weight: 600; }

  /* Lesson viewer */
  #lessonView { display: none; }
  .back-to-vault { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; font-weight: 600; color: var(--ink-500); margin-bottom: 16px; background: none; border: none; padding: 0; }
  .back-to-vault:hover { color: var(--teal-700); }
  .lesson-tab-row { display: flex; gap: 8px; margin-bottom: 22px; flex-wrap: wrap; }
  .lesson-tab { font-size: 12.5px; font-weight: 600; padding: 8px 16px; border-radius: 999px; border: 1px solid var(--line); background: var(--white); color: var(--ink-500); }
  .lesson-tab.active { background: var(--teal-100); color: var(--teal-700); border-color: var(--teal-500); font-weight: 700; }

  .lesson-panel { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-card); padding: 26px 28px; margin-bottom: 20px; }
  .lesson-title { font-family: var(--font-display); font-weight: 700; font-size: 20px; margin-bottom: 2px; }
  .lesson-sub { font-size: 13px; color: var(--ink-500); margin-bottom: 20px; }
  .lesson-body p { font-size: 13.5px; line-height: 1.7; color: var(--ink-700); margin: 0 0 14px; }
  .lesson-body strong { color: var(--ink-900); }
  .lesson-callout { background: var(--teal-100); border-left: 3px solid var(--teal-600); padding: 12px 16px; border-radius: 0 8px 8px 0; font-size: 13px; font-weight: 600; color: var(--teal-700); margin: 0 0 14px; }
  .lesson-mistake { background: var(--rose-100); border-left: 3px solid var(--rose-600); padding: 12px 16px; border-radius: 0 8px 8px 0; font-size: 13px; margin: 0 0 14px; }
  .lesson-mistake::before { content: '⚠ Common Mistake: '; font-weight: 700; color: var(--rose-600); }
  .lesson-pro { background: var(--amber-100); border-left: 3px solid var(--amber-600); padding: 12px 16px; border-radius: 0 8px 8px 0; font-size: 13px; margin: 0 0 14px; }
  .lesson-pro::before { content: '★ Pro Move: '; font-weight: 700; color: var(--amber-600); }
  .lesson-list { font-size: 13.5px; line-height: 1.7; color: var(--ink-700); margin: 0 0 14px; padding-left: 20px; }
  .lesson-list li { margin-bottom: 6px; }

  .script-line { display: flex; gap: 12px; margin-bottom: 14px; }
  .script-who { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; width: 60px; flex-shrink: 0; padding-top: 3px; }
  .script-who.you { color: var(--teal-700); }
  .script-who.them { color: var(--ink-400); }
  .script-who.note { color: var(--amber-600); }
  .script-text { font-size: 13.5px; line-height: 1.6; flex: 1; }
  .script-text.you { font-weight: 600; color: var(--ink-900); }
  .script-text.them { font-style: italic; color: var(--ink-500); }
  .script-text.note { color: var(--amber-600); font-size: 12.5px; }

  .quiz-q { margin-bottom: 22px; }
  .quiz-q-text { font-size: 13.5px; font-weight: 700; margin-bottom: 10px; }
  .quiz-opt { display: block; width: 100%; text-align: left; padding: 10px 14px; border: 1px solid var(--line); border-radius: 8px; background: var(--white); font-size: 12.5px; margin-bottom: 8px; }
  .quiz-opt:hover { background: var(--bg); }
  .quiz-opt.correct { background: var(--teal-100); border-color: var(--teal-600); color: var(--teal-700); font-weight: 700; }
  .quiz-opt.incorrect { background: var(--rose-100); border-color: var(--rose-600); color: var(--rose-600); font-weight: 700; }
  .quiz-why { font-size: 12px; color: var(--ink-500); margin-top: 8px; padding: 10px 12px; background: var(--bg); border-radius: 8px; display: none; }
</style>
</head>
<body>

<div id="viewAsBanner" style="display:none;position:sticky;top:0;z-index:200;background:linear-gradient(90deg,#1A1B2E,#0E1018);color:#fff;padding:10px 24px;font-size:12.5px;font-weight:600;display:none;align-items:center;justify-content:center;gap:10px;">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" width="14" height="14" style="color:#2DD4BF;"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
  <span>Viewing as <strong id="viewAsName">—</strong> — this is exactly what they see.</span>
  <button id="exitViewAsBtn" style="background:rgba(255,255,255,0.12);border:none;color:#fff;font-size:11.5px;font-weight:700;padding:5px 12px;border-radius:999px;margin-left:6px;">Exit Preview</button>
</div>

<script>
(function() {
  // Real fix — the "view as" shim must run before ANY other script on
  // the page reads the advisor ID, so it patches localStorage.getItem
  // itself rather than requiring every page's fetch logic to be touched
  // individually.
  var viewingAsId = sessionStorage.getItem('grwth_viewing_as_id');
  if (viewingAsId) {
    var originalGetItem = Storage.prototype.getItem;
    Storage.prototype.getItem = function(key) {
      if (this === localStorage && key === 'grwth_advisor_id') return viewingAsId;
      return originalGetItem.call(this, key);
    };
  }
})();

document.addEventListener('DOMContentLoaded', function() {
  var apiBase = window.GRWTH_API_BASE || Storage.prototype.getItem.call(localStorage, 'grwth_api_base') || 'https://api.grwthtech.com';
  var realAdvisorId = Storage.prototype.getItem.call(localStorage, 'grwth_advisor_id');
  var viewingAsId = sessionStorage.getItem('grwth_viewing_as_id');
  var viewingAsName = sessionStorage.getItem('grwth_viewing_as_name');

  if (viewingAsId && viewingAsName) {
    document.getElementById('viewAsName').textContent = viewingAsName;
    document.getElementById('viewAsBanner').style.display = 'flex';
  }

  document.getElementById('exitViewAsBtn').addEventListener('click', function() {
    sessionStorage.removeItem('grwth_viewing_as_id');
    sessionStorage.removeItem('grwth_viewing_as_name');
    window.location.reload();
  });

  // Real fix — the "View As" button itself now lives only on
  // Settings, per Logan's requirement. The shim above and this banner
  // still apply on every page so browsing the rest of the app while
  // viewing as someone else keeps working correctly.
});
</script>


<div class="app">
  <aside class="sidebar">
    <div class="brand">
      <img src="grwth-icon.png" alt="GRWTH Coach" class="brand-mark" style="object-fit:cover;">
      <div>
        <div class="brand-name">GRWTH Coach</div>
        <div class="brand-sub">Coach IQ Engine</div>
      </div>
    </div>

    <div class="org-card">
      <div class="org-card-label">Organization</div>
      <div class="org-card-name" id="sidebarOrgName">Loading…</div>
      <span class="org-badge" id="sidebarOrgBadge">—</span>
    </div>

    <div>
      <div class="nav-group-label">Overview</div>
      <a class="nav-item" href="dashboard.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>Dashboard</a>
      <a class="nav-item" href="meetings.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 5L2 7"/></svg>Meetings</a>
      <a class="nav-item" href="coaching-reports.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>Coaching Reports</a>
      <a class="nav-item" href="analytics.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>Analytics</a>
      <div class="nav-group-label">Team</div>
      <a class="nav-item" href="team-performance.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>Team Performance</a>
      <a class="nav-item" href="training-library.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>Training Library</a>
      <a class="nav-item active" href="natural-selling-vault.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5M2 12l10 5 10-5"/></svg>Natural Selling Vault</a>
      <a class="nav-item" href="roleplay.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2M12 19v4M8 23h8"/></svg>Role-Play</a>
      <div class="nav-group-label">Account</div>
      <a class="nav-item" href="settings.html"><svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>Settings</a>
    </div>

    <div class="sidebar-footer">
      <div class="avatar-sm" id="sidebarAvatar">—</div>
      <div>
        <div class="footer-name" id="sidebarFooterName">—</div>
        <div class="footer-role" id="sidebarFooterRole">—</div>
      </div>
    </div>
  </aside>

  <main class="main">
    <div class="topbar-eyebrow">Coach IQ · Methodology</div>
    <h1>The <em>Natural Selling</em> Vault</h1>
    <div class="topbar-sub">The framework behind every score in this app — 8 modules, real scripts, real reframes.</div>

    <div id="vaultHome">
      <div class="method-card" id="methodCard"></div>
      <div class="section-label">The 8 Modules</div>
      <div class="module-grid" id="moduleGrid"></div>
    </div>

    <div id="lessonView">
      <button class="back-to-vault" id="backToVaultBtn">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14"><path d="m15 18-6-6 6-6"/></svg>
        Back to the Vault
      </button>
      <div class="topbar-eyebrow" id="moduleTag">—</div>
      <h1 id="moduleTitle" style="font-size:26px;">—</h1>
      <div class="topbar-sub" id="moduleDesc">—</div>
      <div class="lesson-tab-row" id="lessonTabRow"></div>
      <div id="lessonContent"></div>
      <div class="lesson-panel" id="quizPanel" style="display:none;">
        <h3 style="font-family:var(--font-display);font-weight:700;font-size:16px;margin:0 0 4px;">Check Your Understanding</h3>
        <p style="font-size:12.5px;color:var(--ink-500);margin:0 0 20px;">Quick quiz on this module — no pressure, just a gut check.</p>
        <div id="quizQuestions"></div>
      </div>
    </div>
  </main>
</div>

<script>
window.VAULT_CONTENT = (function(){

var MODULES = [
{id:'foundations', ix:'01', title:'Foundations', tag:'Core',
 desc:'Why pressure kills the sale, the trusted-agent posture that replaces it, and the inner game that lets you stay calm when money is on the line. Everything else stands on this.',
 lessons:[
  {title:'Why Pressure Kills the Sale', sub:'The psychology of resistance', tag:'Core',
   body:[
    {t:'p',c:'The instant a prospect senses that you <strong>need</strong> this sale, a wall goes up. That wall is not about your product, your price, or your pitch — it is a reflex against being pushed. Remove the push, and the wall has nothing to hold up.'},
    {t:'p',c:'Natural Selling inverts the usual motion. Instead of presenting and persuading, you ask calm, well-built questions that let the prospect <strong>say the important things out loud themselves</strong>. Your job shifts from convincing to guiding. You become the steady professional who already understands their situation — not one more voice trying to close them.'},
    {t:'callout',c:'You are the agent who already read the chart — not the rep working down a call list.'},
    {t:'p',c:'Three habits quietly signal pressure and switch on resistance. Catch yourself before you do any of them:'},
    {t:'list',c:['Talking about your solution before the prospect feels a problem worth solving','Speaking more than you listen — every extra sentence raises their guard','Lighting up the moment they show a buying signal, which tells them you were waiting to pounce']},
    {t:'mistake',c:'The most common rookie error: hearing one pain point and immediately launching into how your product fixes it. You just traded a conversation for a pitch, and the wall goes right back up.'},
    {t:'p',c:'When you genuinely slow down and lead with curiosity, something counterintuitive happens: the prospect relaxes, opens up, and starts doing the persuading for you. That is the whole game.'},
    {t:'pro',c:'Record one of your own calls and count the seconds you spend talking versus listening. Elite agents are usually listening 70% of the time in the early stages. If you are over 50%, that is the first thing to fix.'}
   ],
   script:[
    {who:'note',c:'Open neutral and unhurried. Let your tone settle downward at the end of sentences. Certainty calms people; eagerness alarms them.'},
    {who:'you',c:"Hey [First Name], appreciate you carving out the time. Before I share anything about what we do, I'd honestly rather just understand your situation first — would that be alright with you?"},
    {who:'them',c:"Yeah, that's fine."},
    {who:'note',c:'You asked permission and promised to listen first. Zero pressure has entered the room — and you already sound different from every other call they have taken.'}
   ]},
  {title:'The Trusted-Agent Posture', sub:'Status, tone, and healthy detachment', tag:'Core',
   body:[
    {t:'p',c:'Detachment is leverage. When you are truly willing to conclude "this may not be a fit," the prospect feels it — and paradoxically trusts you more. Neediness repels; calm willingness to walk away attracts.'},
    {t:'p',c:'Your <strong>tone</strong> carries more weight than your words. A neutral, curious, lightly detached delivery tells the prospect you are an expert assessing fit, not a salesperson chasing a commission. Same sentence, different tone, opposite result.'},
    {t:'callout',c:'Posture rule: you are diagnosing, not defending.'},
    {t:'p',c:'This posture is not an act. You earn the right to it by actually being willing to tell a prospect the truth — including "based on what you have told me, I am not sure we are the right fit." That honesty is the most disarming thing in the entire conversation.'},
    {t:'mistake',c:'Sounding "too excited to help." Over-eagerness reads as commission breath and quietly tells the prospect you need them more than they need you. Dial the energy down, not up.'},
    {t:'pro',c:'Before any important call, take three slow breaths and remind yourself you already have enough clients. That genuine sense of "enough" is what produces real detachment — and prospects can hear it in your voice.'}
   ],
   script:[
    {who:'you',c:"To be straight with you, [First Name], I'm not even sure yet whether what we do makes sense for your situation. That's exactly what these few questions help us figure out together — fair enough?"},
    {who:'note',c:'That single line of honest detachment raises your status and lowers their guard at the same moment. Use it early.'}
   ]},
  {title:'The Inner Game', sub:'Staying calm when money is on the line', tag:'Core',
   body:[
    {t:'p',c:'The skills in this vault only work if you can run them under pressure. When a prospect goes quiet, pushes back, or dangles a big commission, most agents tighten up and revert to old pitching habits. Mastery is staying in the posture precisely when it is hardest.'},
    {t:'p',c:'Your nervous system leaks through the phone. If you are anxious about the outcome, your pace quickens, your tone rises, and you start filling silence. The prospect cannot name it, but they feel it — and it reads as pressure.'},
    {t:'list',c:['Detach from the outcome of any single call — your job is the process, not the close','Treat every "no" as data that sharpens the next conversation','Slow down deliberately when you feel yourself speeding up']},
    {t:'pro',c:'Keep a one-line note where you can see it on calls: "I am here to find out if I can help — nothing more." It re-anchors you the moment you feel the pull to push.'}
   ],
   script:[
    {who:'note',c:'There is no client script for this lesson — the work is internal. But notice how the calm it produces changes every script that follows.'},
    {who:'you',c:"(Silently, before you dial) \u201cWhether this becomes a client or not, my only job right now is to understand them and tell them the truth.\u201d"}
   ]}
 ],
 quiz:[
  {q:'A prospect mentions one pain point early in the call. What is the most on-method response?',
   a:['Immediately explain how your product solves that exact pain','Stay curious and ask a question that lets them say more about it','Acknowledge it and move into your presentation','Tell them you hear that concern a lot and you can help'],
   correct:1, why:'Hearing one pain and pitching trades a conversation for a presentation and raises the wall. Staying curious keeps them talking and persuading themselves.'},
  {q:'Why does a slightly detached tone make you MORE trustworthy, not less?',
   a:['It hides that you need the sale','It signals you are an expert assessing fit, not a rep chasing a commission','It makes the prospect feel pressured to qualify','It lets you control the conversation'],
   correct:1, why:'Genuine willingness to conclude "not a fit" reads as expertise and integrity. Neediness repels; calm detachment attracts.'},
  {q:'In the early stages of a call, roughly what listening-to-talking balance do elite agents aim for?',
   a:['50/50','Listening about 70% of the time','Talking about 70% of the time','It does not matter as long as you cover your points'],
   correct:1, why:'The early stages are about understanding the prospect. Listening ~70% keeps you in the agent posture and surfaces what actually matters to them.'},
  {q:'What is the real reason "sounding too excited to help" backfires?',
   a:['It wastes time','It reads as commission breath and signals you need them more than they need you','Prospects prefer monotone delivery','Enthusiasm is unprofessional'],
   correct:1, why:'Over-eagerness leaks neediness through the phone. Dialing energy down, not up, communicates the calm confidence of someone who already has enough clients.'}
 ]},
{id:'connecting', ix:'02', title:'Connecting & Tone', tag:'Skill',
 desc:'Neutral tone, deliberate pacing, the calibrated pause, and the art of mirroring. How you say it consistently outperforms what you say.',
 lessons:[
  {title:'The Neutral Tone', sub:'Curiosity over enthusiasm', tag:'Skill',
   body:[
    {t:'p',c:'Enthusiasm reads as commission breath. <strong>Curiosity</strong> reads as expertise. Train yourself to ask every question as though you are mildly intrigued by the answer — never eager for it.'},
    {t:'p',c:'The difference is audible. An eager agent rushes the question and leans on the prospect for a yes. A curious agent asks slowly, lets the question land, and seems genuinely interested in whatever comes back. People open up to the second person and shut down on the first.'},
    {t:'list',c:['Let your tone drop at the end of questions instead of rising','Slow your pace — measured speech signals confidence and control','Leave a beat of silence after they answer, so they keep going']},
    {t:'mistake',c:'Up-talking — letting your pitch rise at the end of every sentence. It makes you sound unsure and seeking approval. Practice landing your sentences with a downward, settled tone.'},
    {t:'pro',c:'A soft, low "hm" before a question does more than any clever phrasing. It signals you are genuinely thinking about their answer, and it slows the whole exchange to your pace.'}
   ],
   script:[
    {who:'you',c:"Hm. When you say the market's had you a little uneasy lately... what do you mean by that, exactly?"},
    {who:'note',c:'The soft "hm," the pause, and the unhurried delivery make this feel like real curiosity instead of a setup for a pitch.'}
   ]},
  {title:'The Calibrated Pause', sub:'Silence as a tool', tag:'Skill',
   body:[
    {t:'p',c:'Most agents are terrified of silence and rush to fill it. But the pause is precisely where the prospect does the emotional work. After you ask a question that matters, the most powerful thing you can do is <strong>say nothing</strong>.'},
    {t:'callout',c:'Whoever speaks first after the real question gives up the insight. Let it be them.'},
    {t:'p',c:'Silence feels far longer to you than to them. What feels like an awkward eternity is usually three or four seconds — and in those seconds the prospect is processing, feeling, and often arriving at the conclusion you wanted them to reach on their own.'},
    {t:'mistake',c:'Rescuing the prospect from your own question by adding "...or, you know, whatever works for you." That qualifier deflates the question and tells them they do not have to answer it honestly.'},
    {t:'pro',c:'After your most important question, physically bite your tongue or mute your mic for a three-count. The discomfort is yours to absorb — and absorbing it is the skill.'}
   ],
   script:[
    {who:'you',c:"And if nothing actually changes between now and the day you retire... what does that look like for you?"},
    {who:'note',c:'Then stop. Count to five silently. Do not rescue them, do not add a clarifier. The pause is the technique.'}
   ]},
  {title:'Mirroring & Labeling', sub:'Making them feel understood', tag:'Skill',
   body:[
    {t:'p',c:'People open up to someone who clearly gets them. Two simple tools do most of the work: <strong>mirroring</strong> (repeating their last few words back as a question) and <strong>labeling</strong> (naming the emotion you hear).'},
    {t:'p',c:'Mirroring keeps them talking without you steering. They say "things have just felt uncertain lately," you say "uncertain?" — and they elaborate, usually toward the real issue.'},
    {t:'p',c:'Labeling lowers tension by showing you understand. "It sounds like this has been weighing on you" makes the prospect feel heard, which makes them far more open to the next question.'},
    {t:'pro',c:'Pair them: label first, then go quiet. "It sounds like you have been carrying this alone for a while." ... Silence. That combination opens people up faster than any question.'}
   ],
   script:[
    {who:'them',c:"Honestly, the whole thing has just felt kind of uncertain lately."},
    {who:'you',c:"Uncertain?"},
    {who:'them',c:"Yeah \u2014 like I'm not sure my money's going to last as long as I need it to."},
    {who:'note',c:'One mirrored word moved them from a vague feeling to the actual fear. You steered nothing; you just kept the door open.'}
   ]}
 ],
 quiz:[
  {q:'What does letting your tone rise at the end of sentences ("up-talking") communicate?',
   a:['Confidence and authority','Uncertainty and a need for approval','Friendliness','Professionalism'],
   correct:1, why:'Rising tone sounds unsure and approval-seeking. Landing sentences with a settled, downward tone projects the calm confidence of an agent.'},
  {q:'After you ask your most important question, what is the right move?',
   a:['Immediately offer a few example answers to help them','Stay silent and let them sit with it','Rephrase the question in case it was unclear','Add "or whatever works for you" to ease the pressure'],
   correct:1, why:'The pause is where the prospect does the emotional work. Filling or softening the silence gives up the insight you were after.'},
  {q:'A prospect says "things have just felt uncertain lately." Which response best uses mirroring?',
   a:['"I completely understand, a lot of people feel that way."','"Uncertain?"','"Let me show you how we remove that uncertainty."','"What specifically is making you feel uncertain about your retirement plan?"'],
   correct:1, why:'Mirroring their own word back as a question keeps them talking toward the real issue without you steering — usually more powerful than a longer, leading question.'},
  {q:'What is the purpose of "labeling" an emotion (e.g., "it sounds like this has been weighing on you")?',
   a:['To diagnose the prospect psychologically','To make them feel understood, which opens them to the next question','To change the subject','To demonstrate your expertise'],
   correct:1, why:'Labeling lowers tension and signals you genuinely understand them. A prospect who feels heard is far more open to going deeper.'}
 ]},
{id:'situation', ix:'03', title:'Situation Questions', tag:'Sequence',
 desc:'Mapping the prospect\u2019s current reality without interrogating, sequencing your questions, and earning the right to go deeper. The gentle on-ramp to awareness.',
 lessons:[
  {title:'Mapping the Status Quo', sub:'Understanding where they are today', tag:'Sequence',
   body:[
    {t:'p',c:'Situation questions establish the facts and earn you the right to ask deeper ones later. Keep them light and conversational — you are sketching the map before you ever point out the cliff.'},
    {t:'p',c:'The trap here is interrogation. Fire off five fact-finding questions in a row and you sound like an application form. Instead, ask one, listen, react like a human, then let the next question grow naturally out of their answer.'},
    {t:'list',c:['Ask about what they have, not what they lack — that comes later','Reference what you already know, so it is clear you prepared','One question at a time; never stack two into one breath']},
    {t:'mistake',c:'Machine-gunning questions. "What do you have saved, where is it, who manages it, what are your goals, when do you retire?" all in a row feels like an interrogation and shuts people down.'},
    {t:'pro',c:'React like a human between questions. A simple "got it, that\u2019s pretty common" makes the next question feel like conversation, not data collection.'}
   ],
   script:[
    {who:'you',c:"So as it stands today, most of what you've set aside for retirement — is that sitting in a 401(k), an IRA, or a mix of things?"},
    {who:'them',c:"Mostly my 401(k) from work, and a little in savings."},
    {who:'you',c:"Got it, that's pretty common. And roughly how far out are you from wanting to actually start drawing income from it?"},
    {who:'note',c:'Notice each question builds on the last answer. It feels like a conversation, not a form.'}
   ]},
  {title:'Sequencing Your Questions', sub:'From easy facts to real meaning', tag:'Sequence',
   body:[
    {t:'p',c:'Order matters. Start with the easy, low-stakes facts (what they have, their timeline) before you move toward anything that touches emotion. Trust is built in that order, not the reverse.'},
    {t:'p',c:'Each answer is a thread. A skilled agent pulls the thread the prospect just handed them, rather than jumping to the next item on a mental checklist. The conversation should feel like it is following <strong>them</strong>.'},
    {t:'callout',c:'The best next question is almost always hiding inside their last answer.'},
    {t:'pro',c:'When they mention something with a little emotional charge — "I just want to make sure my wife is taken care of" — flag it mentally and come back to it. That is the thread that leads to the real conversation later.'}
   ],
   script:[
    {who:'you',c:"You mentioned wanting to make sure your wife is taken care of \u2014 tell me a little more about what that looks like for you?"},
    {who:'note',c:'You picked up the emotionally charged thread from earlier instead of marching to the next checklist item. That is sequencing.'}
   ]}
 ],
 quiz:[
  {q:'What is the main risk of asking several situation questions back-to-back?',
   a:['You run out of questions','It feels like an interrogation and shuts the prospect down','You learn too much too fast','The prospect gets bored'],
   correct:1, why:'Stacked fact-finding questions read as an application form. One question at a time, with human reactions between, keeps it a conversation.'},
  {q:'Where is the best next question usually found?',
   a:['On your prepared checklist','Hiding inside the prospect\u2019s last answer','In your product brochure','In the objection-handling section'],
   correct:1, why:'Pulling the thread they just handed you makes the conversation feel like it follows them — which builds trust and surfaces what matters.'},
  {q:'In what order should you sequence situation questions?',
   a:['Emotional questions first, then easy facts','Easy, low-stakes facts first, then toward anything emotional','Whatever order your CRM lists them','Always start with their biggest fear'],
   correct:1, why:'Trust is built by starting low-stakes and earning the right to go deeper. Leading with emotion before trust exists feels invasive.'},
  {q:'A prospect says "I just want to make sure my wife is taken care of." What is the pro move?',
   a:['Immediately pitch a survivor-benefit product','Note the emotional thread and come back to explore it','Tell them that is exactly what you do','Move on to the next fact-finding question'],
   correct:1, why:'That emotionally charged thread leads to the real conversation. Flag it and return to it; do not bulldoze past it or pounce with a pitch.'}
 ]},
{id:'problem', ix:'04', title:'Problem Awareness', tag:'Sequence',
 desc:'Surfacing the gap the prospect hasn\u2019t named yet \u2014 using their own words, never your warnings \u2014 and resisting the urge to pounce the moment they see it.',
 lessons:[
  {title:'Surfacing the Unspoken Gap', sub:'Letting them name the problem', tag:'Sequence',
   body:[
    {t:'p',c:'You never tell a prospect they have a problem. You ask the question that lets <strong>them</strong> discover it. A problem the prospect names themselves creates desire to fix it; a problem you point out creates defensiveness and a reason to argue.'},
    {t:'callout',c:'If you say it, they doubt it. If they say it, it\u2019s true.'},
    {t:'p',c:'The skill is asking in a way that opens a door rather than makes an accusation. "Is it set up the way you want, or are there things you\u2019d change?" invites reflection. "Did you know your plan has a huge gap?" invites a fight. Same topic, completely different doorway.'},
    {t:'mistake',c:'Educating too early. The moment you start explaining what is wrong with their current setup, you have taken ownership of the problem away from them — and handed them something to defend against.'},
    {t:'pro',c:'Phrase the door as a genuine either/or that lets them save face: "or are there things you\u2019d change if you knew exactly how?" The "if you knew how" quietly removes any shame about not having fixed it yet.'}
   ],
   script:[
    {who:'you',c:"When you look at how your retirement money is positioned right now — is it set up the way you'd want it, or are there things you'd change if you knew exactly how?"},
    {who:'them',c:"Honestly... I'm not really sure it's set up right at all."},
    {who:'note',c:'They just named the gap themselves. Do not pounce or pile on. Stay curious and let them keep talking.'}
   ]},
  {title:'Don\u2019t Pounce', sub:'Holding the moment after they see it', tag:'Sequence',
   body:[
    {t:'p',c:'The instant a prospect admits a gap, every old instinct screams "now! present the solution!" Resist it. Pouncing converts a moment of honest reflection back into a sales pitch, and the wall returns.'},
    {t:'p',c:'Instead, stay curious and let them deepen their own awareness. The longer <strong>they</strong> talk about the gap, the more real and urgent it becomes — to them, in their own words.'},
    {t:'callout',c:'When they open the door, do not run through it. Hold it open and let them walk through.'},
    {t:'pro',c:'After they admit a gap, your best line is often just a calm "what makes you say that?" It hands the moment back to them and deepens the awareness instead of capping it with your pitch.'}
   ],
   script:[
    {who:'them',c:"I'm not really sure it's set up right at all."},
    {who:'you',c:"What makes you say that?"},
    {who:'them',c:"Well... honestly I haven't looked at it in years, and I don't really understand half of it."},
    {who:'note',c:'You said five words. They just deepened their own problem awareness and handed you the real issue.'}
   ]}
 ],
 quiz:[
  {q:'Why should you never directly tell a prospect they have a problem?',
   a:['It is against compliance rules','A problem you point out creates defensiveness; one they name themselves creates desire to fix it','It takes too long','They already know their problems'],
   correct:1, why:'If you say it, they doubt it and defend. If they say it, it is true and motivating. Self-discovered problems drive action.'},
  {q:'A prospect just admitted "I\u2019m not sure my plan is set up right." What should you do next?',
   a:['Present your solution while the door is open','Ask a calm follow-up like "what makes you say that?"','Confirm their fear with statistics','Schedule the closing call immediately'],
   correct:1, why:'Pouncing turns reflection back into a pitch. A gentle follow-up hands the moment back and deepens their own awareness.'},
  {q:'Which question opens a door rather than starting a fight?',
   a:['"Did you know your plan has a huge gap?"','"Is it set up the way you\u2019d want, or things you\u2019d change if you knew how?"','"Why hasn\u2019t anyone fixed this for you?"','"Don\u2019t you think you should be worried about this?"'],
   correct:1, why:'The either/or framing invites reflection and "if you knew how" removes shame. Accusatory framing invites defensiveness.'},
  {q:'What does "if you knew exactly how" add to a problem-awareness question?',
   a:['It pressures them to decide','It quietly removes shame about not having fixed it yet','It implies they are uninformed','It shortens the conversation'],
   correct:1, why:'It lets the prospect save face, making it safe to admit the gap without feeling judged for not having addressed it.'}
 ]},
{id:'consequence', ix:'05', title:'Consequence Questions', tag:'Sequence',
 desc:'Letting the prospect feel the cost of doing nothing, tying it to the people they love, and doing it with respect rather than fear. The emotional core of the whole framework.',
 lessons:[
  {title:'The Cost of Doing Nothing', sub:'Future-pacing the pain, gently', tag:'Sequence',
   body:[
    {t:'p',c:'Consequence questions move the prospect from knowing about a problem to <strong>feeling</strong> it. They picture living with the gap unsolved a few years down the road. That felt experience — not your logic — is what creates the desire to act.'},
    {t:'p',c:'Handle this stage with care and respect. The goal is honest reflection, not fear-mongering. You are helping someone look clearly at a future they would rather not leave to chance — because you genuinely can help them change it.'},
    {t:'list',c:['Tie the consequence to the people they love, not just the numbers','Use their own timeline and their own words back to them','Ask the question, then go quiet — let it do its work']},
    {t:'mistake',c:'Turning the consequence into a scare tactic — piling on worst-case numbers until the prospect feels cornered. Cornered people retreat. The power is in their honest reflection, not your pressure.'},
    {t:'pro',c:'The most powerful consequence questions use the word "you" and a person they love in the same sentence: "how would that affect the life you pictured for you and your spouse?" Abstract numbers do not move people; their family does.'}
   ],
   script:[
    {who:'you',c:"If that gap is still sitting there five years into retirement — how do you think that affects the kind of life you've pictured for you and your spouse?"},
    {who:'note',c:'This is often the most important question on the call. Calibrated pause. Do not fill the silence for them.'}
   ]},
  {title:'From Logic to Emotion', sub:'Why feeling beats facts', tag:'Sequence',
   body:[
    {t:'p',c:'People justify decisions with logic but make them with emotion. You can present a flawless spreadsheet and watch a prospect nod, agree, and still do nothing. Consequence questions bridge that gap by making the future <strong>felt</strong>, not just understood.'},
    {t:'p',c:'Notice the shift: situation and problem questions are about facts. Consequence questions are about meaning. "How would that affect..." and "what would that mean for..." pull the prospect into the emotional reality of inaction.'},
    {t:'callout',c:'Facts inform. Emotion moves. Consequence questions are where the conversation finally moves.'},
    {t:'pro',c:'After a consequence question lands and they have sat with it, do not rush to your solution. Sometimes the strongest follow-up is "and how does that sit with you?" — letting them name the feeling out loud cements the desire to change.'}
   ],
   script:[
    {who:'you',c:"And when you imagine that \u2014 how does it sit with you?"},
    {who:'them',c:"Honestly? Not great. I don't want to be a burden on my kids."},
    {who:'note',c:'They just stated the real driver in their own words. No spreadsheet could have produced that sentence.'}
   ]}
 ],
 quiz:[
  {q:'What is the purpose of a consequence question?',
   a:['To present your solution','To move the prospect from knowing about a problem to feeling it','To collect more facts','To pressure them toward a decision'],
   correct:1, why:'Consequence questions create felt experience of inaction, which is what actually drives the desire to act — logic alone rarely does.'},
  {q:'Which consequence question is most likely to move a prospect?',
   a:['"Do you realize you could lose 30% in a downturn?"','"How would that affect the life you pictured for you and your spouse?"','"Are you aware most people outlive their savings?"','"Wouldn\u2019t it be smart to fix this now?"'],
   correct:1, why:'Tying the consequence to "you" and a loved one makes it emotionally real. Abstract numbers and leading questions do not move people the same way.'},
  {q:'Why do flawless logical presentations often fail to produce action?',
   a:['Prospects do not understand them','People make decisions with emotion and justify with logic','They are too long','Prospects prefer to research alone'],
   correct:1, why:'Understanding is not motivation. Consequence questions add the felt, emotional layer that turns agreement into action.'},
  {q:'What is the danger of stacking worst-case numbers to heighten the consequence?',
   a:['It takes too long','It becomes a scare tactic, and cornered people retreat','It is non-compliant','It confuses the prospect'],
   correct:1, why:'Fear-mongering corners the prospect, triggering retreat. The power lives in their honest reflection, not in your pressure.'}
 ]},
{id:'solution', ix:'06', title:'Solution & Commitment', tag:'Sequence',
 desc:'Planting a seed instead of pitching, earning the next appointment without pressure, and letting the prospect ask to move forward. The bridge from problem to plan.',
 lessons:[
  {title:'Seed, Don\u2019t Pitch', sub:'Creating desire for the next call', tag:'Sequence',
   body:[
    {t:'p',c:'On a first conversation you do not pitch a product. You plant a seed and set up a follow-up where you actually educate. Done right, the prospect should leave the call <strong>wanting</strong> the next one — because you have built curiosity, not pressure.'},
    {t:'callout',c:'The goal of call one is a confirmed call two — nothing more.'},
    {t:'p',c:'Give a concrete, prospect-centered reason the next meeting matters. "I\u2019d want to build you a personalized illustration before I say anything specific" tells them the next call has real value built just for them — far stronger than "let\u2019s find a time to chat again."'},
    {t:'mistake',c:'Cramming a full pitch into call one because the prospect "seems interested." Interest is fragile. Dumping everything now removes the reason for call two and reintroduces pressure.'},
    {t:'pro',c:'Tie the next call to something they said earlier: "You mentioned wanting your wife taken care of \u2014 I\u2019d like to build the illustration around exactly that." Now the next call is about their words, not your product.'}
   ],
   script:[
    {who:'you',c:"Based on what you've shared with me, I do think there's a way to close that gap — but I'd want to put together a personalized illustration before I say anything specific, so I'm not guessing. Would it make sense to set a time to walk through it together?"},
    {who:'them',c:"Yeah, I'd like to see that."},
    {who:'note',c:'Set the specific day and time right now, while the desire is fresh. A vague "I\u2019ll follow up" loses them.'}
   ]},
  {title:'Letting Them Ask to Move Forward', sub:'The pressure-free commitment', tag:'Sequence',
   body:[
    {t:'p',c:'The strongest commitment is the one the prospect requests. When you have run the conversation well, they will often ask "so what would this look like for me?" That question is them stepping forward — your job is simply to honor it and set the next step.'},
    {t:'p',c:'If they have not asked yet, you can invite it gently without pressure: a soft "would it be worth exploring what that could look like for you?" lets them say yes on their own terms.'},
    {t:'callout',c:'You are not closing them. You are opening a door and letting them choose to walk through.'},
    {t:'pro',c:'When they ask to move forward, resist the urge to over-celebrate or over-explain. A calm "absolutely \u2014 let\u2019s set that up" keeps your status high and the moment pressure-free.'}
   ],
   script:[
    {who:'them',c:"So what would something like this actually look like for me?"},
    {who:'you',c:"Great question \u2014 that's exactly what I'd build the illustration to show you. Let's get a time on the calendar to walk through it together. Does later this week work?"},
    {who:'note',c:'They asked to move forward. You honored it calmly and set the concrete next step. No closing pressure needed.'}
   ]}
 ],
 quiz:[
  {q:'What is the only goal of the first call?',
   a:['Close the sale','Secure a confirmed second call','Present the full product','Collect payment information'],
   correct:1, why:'Call one seeds curiosity and books call two. Trying to close on call one reintroduces pressure and usually backfires.'},
  {q:'Which reason for a second call is strongest?',
   a:['"Let\u2019s find a time to chat again."','"I\u2019d build a personalized illustration around what you said about your wife."','"I have some products to show you."','"Let me send you a brochure to review."'],
   correct:1, why:'Tying the next call to their own words makes it about them, not your product — far more compelling than a vague follow-up.'},
  {q:'A prospect asks, "So what would this look like for me?" What does that signal?',
   a:['They are stalling','They are stepping forward and requesting commitment','They want a discount','They are confused'],
   correct:1, why:'That question is the prospect asking to move forward. Honor it calmly and set the next step — do not over-sell.'},
  {q:'Why is cramming a full pitch into call one a mistake even when the prospect seems interested?',
   a:['It is too much information legally','Interest is fragile; it removes the reason for call two and adds pressure','Prospects prefer email','It wastes your time'],
   correct:1, why:'Dumping everything now spends the curiosity that earns the next meeting and reintroduces the pressure you worked to remove.'}
 ]},
{id:'objections', ix:'07', title:'Objection Reframes', tag:'Reframe',
 desc:'Treating every objection as a concern, surfacing the real one, and turning resistance into the next question. Your living library of reframes.',
 lessons:[
  {title:'Objections Are Concerns', sub:'The mindset shift that changes everything', tag:'Reframe',
   body:[
    {t:'p',c:'An objection is not a rejection of you — it is a <strong>concern</strong> the prospect has not fully worked out. The instant you stop hearing "no" and start hearing "I have an unanswered worry," your whole response changes from defending to understanding.'},
    {t:'p',c:'Most agents react to objections. They argue, justify, or pile on benefits. All of that confirms the prospect\u2019s instinct to retreat. The move is the opposite: get curious about the concern underneath.'},
    {t:'callout',c:'Do not handle the objection. Understand the concern.'},
    {t:'mistake',c:'Treating an objection as a debate to win. Every point you "win" costs you trust. You can be right and still lose the relationship.'},
    {t:'pro',c:'Before responding to any objection, take a breath and silently ask yourself: "what is the real concern underneath this?" That half-second resets you from reacting to understanding.'}
   ],
   script:[
    {who:'them',c:"I'm just not sure this is right for me."},
    {who:'you',c:"That's completely fair. Help me understand \u2014 when you say you're not sure, what's the part that feels off?"},
    {who:'note',c:'You did not defend or persuade. You treated it as a concern and asked them to locate the real one.'}
   ]},
  {title:'\u201CI need to think about it\u201D', sub:'The stall reframe', tag:'Reframe',
   body:[
    {t:'p',c:'"I need to think about it" almost never means thinking. It means there is an unspoken concern the prospect has not voiced. Your job is to surface that concern calmly — never to overcome the stall with more pressure, which only confirms their instinct to retreat.'},
    {t:'p',c:'The move is to make it safe and easy for them to tell you the real thing. You do that by normalizing it ("totally fair, that\u2019s common") and then gently asking them to locate the one piece that is not yet clear.'},
    {t:'pro',c:'If they still cannot name it, offer the two most common concerns as a gentle multiple choice: "Is it more the cost, or more whether it\u2019ll actually do what you need?" Naming options makes it easy for them to point at the real one.'}
   ],
   script:[
    {who:'them',c:"I think I just need a little time to think it over."},
    {who:'you',c:"Totally fair — most people say that. Usually when someone needs to think, there's one specific thing that's not quite clear yet. If you had to guess, what would that one thing be for you?"},
    {who:'note',c:'This brings the real objection into the open without any pressure, so you can actually address it.'}
   ]},
  {title:'\u201CI need to talk to my spouse\u201D', sub:'The decision-maker reframe', tag:'Reframe',
   body:[
    {t:'p',c:'A genuine spouse objection is usually a signal that you skipped the "who else is part of this decision" question earlier. Handle it by <strong>including</strong> the spouse, never by trying to push past them — pushing past the decision-maker is how deals die quietly.'},
    {t:'p',c:'Frame the joint meeting as a benefit to them: their spouse hears it firsthand and accurately, instead of secondhand and watered-down through a tired retelling at the dinner table.'},
    {t:'pro',c:'Prevent this objection entirely by asking early: "When it comes to a decision like this, is it just you, or is there anyone else you\u2019d normally talk it through with?" Asked up front, it is information. Asked at the end, it is an obstacle.'}
   ],
   script:[
    {who:'you',c:"That makes complete sense — this should absolutely be a decision the two of you feel good about together. What if we set the next call for a time you can both be on? That way your spouse hears everything firsthand instead of secondhand from you after a long day."},
    {who:'note',c:'You honored the objection and turned it into a better, fuller next appointment.'}
   ]},
  {title:'\u201CI don\u2019t have a mortgage\u201D', sub:'The protection reframe', tag:'Reframe',
   body:[
    {t:'p',c:'Common when a lead came in through a protection-focused offer. The reframe is to move off the specific product and onto the underlying need: protecting the income, and the people who depend on it.'},
    {t:'p',c:'Agree with them warmly first — a paid-off home is genuinely good news — then open the real door with a question about whether the income their family relies on is actually protected.'},
    {t:'pro',c:'The pattern works for almost any "I don\u2019t need X" objection: agree warmly, then ask a question that widens the lens from the narrow product to the broader goal they actually care about.'}
   ],
   script:[
    {who:'you',c:"Oh, even better — so the house is paid off, that's a great position to be in. Can I ask, though: if something happened to you tomorrow, is the income your family counts on protected, or is that still tied to you being here?"},
    {who:'note',c:'You pivoted from "mortgage" to "income protection" without losing the conversation or sounding salesy.'}
   ]}
 ],
 quiz:[
  {q:'What is the single most important mindset shift about objections?',
   a:['Objections mean the prospect is not qualified','An objection is a concern, not a rejection of you','Objections should be overcome with more benefits','Objections mean you priced too high'],
   correct:1, why:'Hearing "concern" instead of "no" changes your response from defending to understanding — which is what actually resolves it.'},
  {q:'A prospect says "I need to think about it." What does it usually really mean?',
   a:['They genuinely need quiet time to think','There is an unspoken concern they have not voiced','They are not interested','They want a follow-up email'],
   correct:1, why:'The stall almost always hides one specific concern. Surfacing it calmly beats applying more pressure.'},
  {q:'Best way to handle "I need to talk to my spouse"?',
   a:['Explain why they can decide on their own','Push for a decision today','Include the spouse by setting a joint next call','Offer a discount if they decide now'],
   correct:2, why:'Including the decision-maker honors the objection and creates a fuller next meeting. Pushing past the spouse kills deals quietly.'},
  {q:'On "I don\u2019t have a mortgage," what is the reframe pattern?',
   a:['Explain why they still need mortgage protection','Agree warmly, then widen the lens to income protection','End the call politely','Argue that everyone needs coverage'],
   correct:1, why:'Agree first (a paid-off home is good news), then pivot with a question to the broader need they actually care about.'}
 ]},
{id:'teardowns', ix:'08', title:'Live Call Teardowns', tag:'Teardown',
 desc:'Real calls scored against the method, a repeatable scoring framework, and your own recordings dissected. Where the theory becomes muscle memory.',
 lessons:[
  {title:'How to Score Any Call', sub:'The teardown framework', tag:'Teardown',
   body:[
    {t:'p',c:'Mastery comes from reviewing real calls against a consistent framework — yours and your teammates\u2019. Without a scoring lens, a call review is just opinions. With one, it becomes targeted practice.'},
    {t:'p',c:'Score every call against these checkpoints, in order:'},
    {t:'list',c:['Did the opening lower resistance, or introduce pressure?','Were situation questions conversational, or an interrogation?','Did the prospect name the problem, or did the agent point it out?','Was there a real consequence question \u2014 and a pause after it?','Did call one seed call two, or try to close?']},
    {t:'callout',c:'A call review without a framework is just opinions. The checkpoints turn it into practice.'},
    {t:'pro',c:'Score your own calls before anyone else does. Listen back with the five checkpoints in front of you and mark the exact timestamp where you first felt the energy shift. That timestamp is your next rep.'}
   ],
   script:[
    {who:'note',c:'Use this pane to paste the corrected, line-by-line "redo" of a real call \u2014 the same moment, run the right way.'},
    {who:'you',c:"[Paste your corrected version of the teardown call here \u2014 the same moment, the method way.]"},
    {who:'note',c:'Seeing the wrong version and the right version back to back is where the lesson actually sticks.'}
   ]},
  {title:'Teardown: The Rushed Close', sub:'What pressure looks like on tape', tag:'Teardown',
   body:[
    {t:'p',c:'In this teardown we score a call where the agent pitched before the prospect felt a problem worth solving. As you read, mark the exact moment the prospect\u2019s guard goes up — it is almost always right after the agent starts presenting too early.'},
    {t:'callout',c:'Drop your own call recording or screen-share link here for each teardown lesson.'},
    {t:'mistake',c:'The agent in this call heard one buying signal and immediately presented the product. Watch how the prospect\u2019s answers get shorter and cooler from that exact moment on.'},
    {t:'p',c:'Run the redo against the framework from the previous lesson and notice how a single change — staying curious instead of pitching — reroutes the entire conversation.'}
   ],
   script:[
    {who:'note',c:'The wrong version: agent pitches at the first sign of interest.'},
    {who:'you',c:"[Paste the original rushed line here, then the corrected curious version beneath it.]"},
    {who:'note',c:'The contrast is the lesson. Same prospect, same opening \u2014 completely different outcome.'}
   ]}
 ],
 quiz:[
  {q:'Why review calls against a consistent framework instead of just listening back?',
   a:['It is faster','Without a framework, a review is just opinions; with one, it becomes targeted practice','Frameworks impress managers','It avoids disagreements'],
   correct:1, why:'A scoring lens turns vague impressions into specific, repeatable practice on the exact moments that matter.'},
  {q:'In the "Rushed Close" teardown, when does the prospect\u2019s guard typically go up?',
   a:['At the very start of the call','Right after the agent starts presenting too early','When the agent asks a consequence question','When the agent books a second call'],
   correct:1, why:'Pitching before the prospect feels a problem is the trigger. You can hear answers get shorter and cooler from that exact point.'},
  {q:'Which is one of the five teardown checkpoints?',
   a:['Did the agent mention the company\u2019s awards?','Did call one seed call two, or try to close?','Did the agent talk faster than the prospect?','Did the agent send a follow-up email?'],
   correct:1, why:'Whether call one seeds call two (vs. trying to close) is a core checkpoint — it reveals whether pressure crept back in.'},
  {q:'What makes the "redo" version of a call such a powerful teaching tool?',
   a:['It is shorter','Seeing the wrong and right versions back to back is where the lesson sticks','It proves the agent was wrong','It can be shared on social media'],
   correct:1, why:'The direct contrast — same moment, run two ways — cements the difference far better than abstract advice.'}
 ]}
];

var PATHS = [
 {name:'The First Call', tag:'Start here', color:'#69d4c2',
  desc:'From hello to a booked next appointment — open without resistance and earn the right to a real conversation.',
  steps:['foundations','connecting','situation','solution']},
 {name:'The Closing Conversation', tag:'Core skill', color:'#48ad9d',
  desc:'The heart of the method: ask the questions that make the prospect persuade themselves.',
  steps:['situation','problem','consequence','solution']},
 {name:'When They Push Back', tag:'Objections', color:'#caa24c',
  desc:'Treat every objection as a concern. Surface it, honor it, and turn it into the next question.',
  steps:['objections','consequence','connecting']},
 {name:'Sharpen on Real Calls', tag:'Advanced', color:'#8beedc',
  desc:'Pressure-test everything against recorded calls until the moves become automatic.',
  steps:['teardowns','objections','solution']}
];

var METHOD = {
 lead:'\u201CThe moment a prospect feels sold to, they push back. The entire method exists to remove that feeling.\u201D',
 paras:[
  'Traditional selling leads with the pitch — features, benefits, urgency, a close. The prospect\u2019s guard goes up because they have heard that script a thousand times and they know how it ends. This vault teaches the opposite motion: <strong>lead with skilled questions</strong> that help the prospect discover the gap between where they are and where they want to be. When they put that gap into their own words, they own the conclusion. And people do not argue with their own conclusions.',
  'None of this is manipulation. It is the discipline of slowing down, listening more than you talk, and being genuinely willing to tell someone the truth — even when the truth is "this might not be a fit." That honesty is what makes you trustworthy, and trust is what makes the rest of the conversation possible.'
 ],
 stages:[
  ['Connection','Lower resistance and earn trust before you earn attention. Tone does most of the work here.'],
  ['Engagement','Situation, problem-awareness, and consequence questions — where the majority of the sale is actually made.'],
  ['Transition','Move from problem to solution on the prospect\u2019s terms, not yours. Seed the next step.'],
  ['Commitment','Let them ask to move forward, and surface concerns calmly as they come up.']
 ],
 note:'We teach this as our GRWTH approach to consultative selling. Every lesson and script in this vault is written in our own words, for our own team — explained and taught the GRWTH way.'
};

var COACH_KB = [
 {k:['price','expensive','cost','afford','too much','budget','money'], title:'Price concern',
  answer:"Treat a price concern as information, not rejection. Don't jump to logic or discounts.\n\n- First **clarify**: *\"When you say it's more than you wanted, what number were you expecting?\"*\n- Then **connect it back to the gap** they already told you matters: *\"Earlier you mentioned the income gap worries you — how does the cost compare to leaving that gap unsolved?\"*\n\nThe goal is to let them weigh cost against the problem in their own words, not to defend your price."},
 {k:['think about it','think it over','need time','get back to you','sleep on it'], title:'\u201CI need to think about it\u201D',
  answer:"This almost always hides one specific concern. Make it safe to say out loud.\n\n*\"Totally fair, most people say that. Usually there's one thing that's not quite clear yet — if you had to guess, what would that one thing be?\"*\n\nThen go quiet and let them locate it. You can't handle an objection you can't see."},
 {k:['spouse','wife','husband','partner','talk to','both of us','my wife','my husband'], title:'Spouse / decision-maker',
  answer:"Don't push past the spouse — include them. Frame the joint call as a benefit to the prospect.\n\n*\"That makes total sense — this should be a decision you both feel good about. What if we set the next call for a time you can both be on, so they hear it firsthand instead of secondhand from you?\"*\n\nIf this comes up a lot, you're likely skipping the \"who else is part of this decision\" question earlier in the call."},
 {k:['mortgage','don\'t have a mortgage','paid off','no mortgage','protection'], title:'\u201CI don\u2019t have a mortgage\u201D',
  answer:"Agree warmly, then pivot from the product to the underlying need.\n\n*\"Oh, even better — the home's paid off, that's a great spot to be in. Can I ask, though: if something happened to you tomorrow, is the income your family relies on protected, or is that still tied to you being here?\"*\n\nYou move from 'mortgage' to 'income protection' without losing the call."},
 {k:['cold','open','opener','first call','start the call','introduction','intro'], title:'Opening a call',
  answer:"Open neutral and ask permission to understand them first. This instantly separates you from every other call.\n\n*\"Hey [First Name], appreciate the time. Before I share anything about what we do, I'd rather understand your situation first — would that be alright?\"*\n\nLow tone at the end, unhurried pace. Certainty calms; eagerness alarms."},
 {k:['situation question','fact find','discovery','where they are','current'], title:'Situation questions',
  answer:"Map the status quo without interrogating. One question at a time, each growing from the last answer.\n\n*\"Most of what you've saved — is that in a 401(k), an IRA, or a mix?\"* ... then react ... *\"And how far out are you from wanting to draw income from it?\"*\n\nAsk about what they **have**, not what they lack — the gap comes later."},
 {k:['problem','gap','awareness','aware','surface'], title:'Problem-awareness questions',
  answer:"Never tell them they have a problem — ask a question that lets them discover it.\n\n*\"When you look at how your money's positioned today, is it set up the way you'd want, or are there things you'd change if you knew how?\"*\n\nIf you say it, they doubt it. If they say it, it's true. Stay curious when they name the gap — don't pounce."},
 {k:['consequence','cost of doing nothing','urgency','future','pain','feel'], title:'Consequence questions',
  answer:"Move them from knowing about the problem to feeling it. Tie it to people, not just numbers.\n\n*\"If that gap is still there five years into retirement, how does that affect the life you pictured for you and your spouse?\"*\n\nThen the calibrated pause — ask, and go silent. Don't rescue them from the question."},
 {k:['close','closing','commit','commitment','next appointment','second call','book'], title:'Seeding the next call',
  answer:"On call one you don't pitch — you seed and book call two with a concrete, prospect-centered reason.\n\n*\"I think there's a way to close that gap, but I'd want to build you a personalized illustration before I say anything specific. Would it make sense to set a time to walk through it together?\"*\n\nThen set the specific day and time right now."},
 {k:['tone','pause','silence','pacing','curious','curiosity','enthusiasm'], title:'Tone & the calibrated pause',
  answer:"Curiosity reads as expertise; enthusiasm reads as commission breath.\n\n- Drop your tone at the end of questions\n- Slow your pace — it signals control\n- After a real question, **say nothing** for a count of five\n\nWhoever speaks first after the question gives up the insight. Let it be them."},
 {k:['detach','detachment','posture','status','walk away','advisor','agent'], title:'Trusted-agent posture',
  answer:"Detachment is leverage. Being genuinely willing to say \"this may not be a fit\" makes you more trustworthy, not less.\n\n*\"To be straight with you, I'm not sure yet whether what we do makes sense for you — that's what these questions help us figure out together.\"*\n\nYou're diagnosing, not defending."}
];

var COACH_FALLBACK = "Good question. Here's how I'd think about it through the method:\n\nWhatever the moment is, slow it down and turn it into a **question** rather than a statement. Let the prospect put the important thing into their own words — that's what creates real movement.\n\nTry me with something specific: a price concern, a stall like *\"I need to think about it,\"* opening a cold call, or building a consequence question for a retirement prospect. You can also open a lesson in the Library and hit **\u201CAsk the coach about this\u201D** to drill in.";

var SUGGESTIONS = [
 "Role-play a price objection with me",
 "How do I handle \u201CI need to think about it\u201D?",
 "Draft a consequence question for a retirement prospect",
 "How should I open a cold call?",
 "Turn \u201CI need to talk to my spouse\u201D into a reframe"
];

return {
  MODULES: MODULES,
  PATHS: PATHS,
  METHOD: METHOD,
  COACH_KB: COACH_KB,
  COACH_FALLBACK: COACH_FALLBACK,
  SUGGESTIONS: SUGGESTIONS
};

})();

const API_BASE = window.GRWTH_API_BASE || localStorage.getItem('grwth_api_base') || 'https://api.grwthtech.com';
const ADVISOR_ID = window.GRWTH_ADVISOR_ID || localStorage.getItem('grwth_advisor_id') || '';

// Maps Coach IQ's category keys/labels to this vault's module ids, so the
// "Practice" deep-links from Call Review and Coaching Reports land on the
// right module instead of just dumping the user on the vault homepage.
const CATEGORY_TO_MODULE = {
  'fnd': 'foundations', 'foundations': 'foundations',
  'ct': 'connecting', 'connecting & tone': 'connecting', 'connecting': 'connecting',
  'sit': 'situation', 'situation questions': 'situation', 'situation': 'situation',
  'pa': 'problem', 'problem awareness': 'problem', 'problem': 'problem',
  'cq': 'consequence', 'consequence questions': 'consequence', 'consequence': 'consequence',
  'sc': 'solution', 'solution & commitment': 'solution', 'solution': 'solution',
  'obj': 'objections', 'objection reframes': 'objections', 'objections': 'objections',
  'lct': 'teardowns', 'live call teardown': 'teardowns', 'teardowns': 'teardowns',
};

(function () {
  const name = localStorage.getItem('grwth_advisor_name');
  const role = localStorage.getItem('grwth_advisor_role');
  const nameEl = document.getElementById('sidebarFooterName');
  const roleEl = document.getElementById('sidebarFooterRole');
  const avatarEl = document.getElementById('sidebarAvatar');
  const roleLabel = role === 'agency_owner' ? 'Agency Owner' : role === 'admin' ? 'Admin' : 'Agent';
  if (name && nameEl) nameEl.textContent = name;
  if (role && roleEl) roleEl.textContent = roleLabel;
  if (name && avatarEl) {
    avatarEl.textContent = name.split(/\s+/).filter(Boolean).slice(0, 2).map(w => w[0]).join('').toUpperCase();
    var cachedPhoto = localStorage.getItem('grwth_advisor_photo');
    if (cachedPhoto && avatarEl) {
      avatarEl.style.backgroundImage = 'url(' + cachedPhoto + ')';
      avatarEl.style.backgroundSize = 'cover';
      avatarEl.style.backgroundPosition = 'center';
      avatarEl.textContent = '';
    }
  }
  const orgNameEl = document.getElementById('sidebarOrgName');
  const orgBadgeEl = document.getElementById('sidebarOrgBadge');
  if (orgBadgeEl) orgBadgeEl.textContent = roleLabel;
  if (orgNameEl) orgNameEl.textContent = 'GRWTH TECH';
  if (ADVISOR_ID && orgNameEl) {
    fetch(`${API_BASE}/api/grwth-coach/me`, { credentials: 'include', headers: { 'x-advisor-id': ADVISOR_ID } })
      .then(r => r.json())
      .then(me => {
        orgNameEl.textContent = me.teamName || 'GRWTH TECH';
        if (me.photoUrl && avatarEl) {
          avatarEl.style.backgroundImage = 'url(' + me.photoUrl + ')';
          avatarEl.style.backgroundSize = 'cover';
          avatarEl.style.backgroundPosition = 'center';
          avatarEl.textContent = '';
          localStorage.setItem('grwth_advisor_photo', me.photoUrl);
        } else if (avatarEl) {
          avatarEl.style.backgroundImage = '';
          localStorage.removeItem('grwth_advisor_photo');
        }
        if (orgBadgeEl && me.roleLabel) orgBadgeEl.textContent = me.roleLabel;
      })
      .catch(() => {});
  }

  var footer = document.querySelector('.sidebar-footer');
  if (footer) {
    var themeBtn = document.createElement('button');
    themeBtn.id = 'themeToggleBtn';
    themeBtn.title = 'Toggle dark mode';
    themeBtn.style.cssText = 'margin-left:auto;border:1px solid var(--line);background:var(--bg);color:var(--ink-700);width:30px;height:30px;border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0;padding:0;';
    themeBtn.innerHTML =
      '<svg id="themeIconSun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>' +
      '<svg id="themeIconMoon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="15" height="15" style="display:none;"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z"/></svg>';
    function applyThemeIcon() {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      document.getElementById('themeIconSun').style.display = isDark ? 'none' : 'block';
      document.getElementById('themeIconMoon').style.display = isDark ? 'block' : 'none';
    }
    themeBtn.addEventListener('click', function() {
      var isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      if (isDark) {
        document.documentElement.removeAttribute('data-theme');
        localStorage.setItem('grwth_theme', 'light');
      } else {
        document.documentElement.setAttribute('data-theme', 'dark');
        localStorage.setItem('grwth_theme', 'dark');
      }
      applyThemeIcon();
    });
        var logoutBtn = document.createElement('button');
    logoutBtn.textContent = 'Log Out';
    logoutBtn.style.cssText = 'background:none;border:none;color:var(--ink-500);font-size:11px;font-weight:600;cursor:pointer;padding:4px 8px;font-family:inherit;';
    logoutBtn.addEventListener('mouseenter', function() { logoutBtn.style.color = '#2DD4BF'; });
    logoutBtn.addEventListener('mouseleave', function() { logoutBtn.style.color = 'var(--ink-500)'; });
    logoutBtn.addEventListener('click', async function() {
      try {
        await fetch(API_BASE + '/api/grwth-coach/auth/logout', { method: 'POST', credentials: 'include' });
      } catch (err) {
        console.warn('[GRWTH Coach] Logout request failed:', err.message);
      }
      localStorage.removeItem('grwth_advisor_id');
      localStorage.removeItem('grwth_advisor_name');
      localStorage.removeItem('grwth_advisor_email');
      localStorage.removeItem('grwth_advisor_role');
      window.location.href = 'login.html';
    });
    footer.appendChild(logoutBtn);
    footer.appendChild(themeBtn);
    applyThemeIcon();
  }
})();

function renderMethodCard() {
  const m = window.VAULT_CONTENT.METHOD;
  document.getElementById('methodCard').innerHTML = `
    <div class="method-lead">${m.lead}</div>
    ${m.paras.map(p => `<div class="method-para">${p}</div>`).join('')}
    <div class="method-stages">
      ${m.stages.map(([title, desc]) => `
        <div class="method-stage">
          <div class="method-stage-title">${title}</div>
          <div class="method-stage-desc">${desc}</div>
        </div>
      `).join('')}
    </div>
  `;
}

function renderModuleGrid() {
  const grid = document.getElementById('moduleGrid');
  grid.innerHTML = window.VAULT_CONTENT.MODULES.map(m => `
    <div class="module-card" data-module-id="${m.id}">
      <div class="module-card-top">
        <span class="module-ix">${m.ix}</span>
        <span class="module-tag">${m.tag}</span>
      </div>
      <div class="module-title">${m.title}</div>
      <div class="module-desc">${m.desc}</div>
      <div class="module-lesson-count">${m.lessons.length} lesson${m.lessons.length === 1 ? '' : 's'} · ${m.quiz.length}-question quiz</div>
    </div>
  `).join('');

  grid.querySelectorAll('.module-card').forEach(card => {
    card.addEventListener('click', () => openModule(card.dataset.moduleId));
  });
}

let activeModule = null;
let activeLessonIndex = 0;

function openModule(moduleId, lessonIndex) {
  const mod = window.VAULT_CONTENT.MODULES.find(m => m.id === moduleId);
  if (!mod) return;
  activeModule = mod;
  activeLessonIndex = lessonIndex || 0;

  document.getElementById('vaultHome').style.display = 'none';
  document.getElementById('lessonView').style.display = 'block';
  document.getElementById('moduleTag').textContent = `Coach IQ · ${mod.tag}`;
  document.getElementById('moduleTitle').textContent = mod.title;
  document.getElementById('moduleDesc').textContent = mod.desc;

  document.getElementById('lessonTabRow').innerHTML = mod.lessons.map((l, i) => `
    <button class="lesson-tab ${i === activeLessonIndex ? 'active' : ''}" data-lesson-idx="${i}">${l.title}</button>
  `).join('') + `<button class="lesson-tab" data-lesson-idx="quiz">Quiz</button>`;

  document.getElementById('lessonTabRow').querySelectorAll('.lesson-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      if (tab.dataset.lessonIdx === 'quiz') {
        showQuiz();
      } else {
        activeLessonIndex = Number(tab.dataset.lessonIdx);
        renderLesson();
      }
      document.getElementById('lessonTabRow').querySelectorAll('.lesson-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
    });
  });

  renderLesson();
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function bodyItemHTML(item) {
  if (item.t === 'p') return `<p>${item.c}</p>`;
  if (item.t === 'callout') return `<div class="lesson-callout">${item.c}</div>`;
  if (item.t === 'mistake') return `<div class="lesson-mistake">${item.c}</div>`;
  if (item.t === 'pro') return `<div class="lesson-pro">${item.c}</div>`;
  if (item.t === 'list') return `<ul class="lesson-list">${item.c.map(li => `<li>${li}</li>`).join('')}</ul>`;
  return '';
}

function renderLesson() {
  document.getElementById('quizPanel').style.display = 'none';
  const lesson = activeModule.lessons[activeLessonIndex];
  document.getElementById('lessonContent').innerHTML = `
    <div class="lesson-panel">
      <div class="lesson-title">${lesson.title}</div>
      <div class="lesson-sub">${lesson.sub}</div>
      <div class="lesson-body">${lesson.body.map(bodyItemHTML).join('')}</div>
    </div>
    <div class="lesson-panel">
      <h3 style="font-family:var(--font-display);font-weight:700;font-size:15px;margin:0 0 16px;">Script</h3>
      ${lesson.script.map(line => `
        <div class="script-line">
          <div class="script-who ${line.who}">${line.who === 'you' ? 'You' : line.who === 'them' ? 'Prospect' : 'Coach'}</div>
          <div class="script-text ${line.who}">${line.c}</div>
        </div>
      `).join('')}
    </div>
  `;
}

function showQuiz() {
  document.getElementById('lessonContent').innerHTML = '';
  const panel = document.getElementById('quizPanel');
  panel.style.display = 'block';
  document.getElementById('quizQuestions').innerHTML = activeModule.quiz.map((q, qi) => `
    <div class="quiz-q">
      <div class="quiz-q-text">${qi + 1}. ${q.q}</div>
      ${q.a.map((opt, oi) => `<button class="quiz-opt" data-q="${qi}" data-o="${oi}">${opt}</button>`).join('')}
      <div class="quiz-why" id="quizWhy-${qi}">${q.why}</div>
    </div>
  `).join('');

  document.getElementById('quizQuestions').querySelectorAll('.quiz-opt').forEach(btn => {
    btn.addEventListener('click', () => {
      const qi = Number(btn.dataset.q);
      const oi = Number(btn.dataset.o);
      const q = activeModule.quiz[qi];
      const allOptsForQ = document.querySelectorAll(`.quiz-opt[data-q="${qi}"]`);
      allOptsForQ.forEach(o => o.disabled = true);
      btn.classList.add(oi === q.correct ? 'correct' : 'incorrect');
      if (oi !== q.correct) {
        allOptsForQ[q.correct].classList.add('correct');
      }
      document.getElementById(`quizWhy-${qi}`).style.display = 'block';
    });
  });
}

document.getElementById('backToVaultBtn').addEventListener('click', () => {
  document.getElementById('lessonView').style.display = 'none';
  document.getElementById('vaultHome').style.display = 'block';
  history.replaceState(null, '', 'natural-selling-vault.html');
});

(function init() {
  renderMethodCard();
  renderModuleGrid();

  const categoryParam = new URLSearchParams(window.location.search).get('category');
  if (categoryParam) {
    const moduleId = CATEGORY_TO_MODULE[categoryParam.toLowerCase()];
    if (moduleId) openModule(moduleId, 0);
  }
})();
</script>
</body>
</html>
